import pandas as pd
import numpy as np
import tensorflow as tf
import zipfile
import os

from tensorflow.keras.models import Model
from tensorflow.keras.layers import (
    Input, Embedding, Flatten, Concatenate,
    Dense, Dropout
)
from tensorflow.keras.optimizers import Adam
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder

# Reproducibility
np.random.seed(42)
tf.random.set_seed(42)

print("Libraries imported successfully!")

# 1. Download and load the Online Retail dataset

url = "https://archive.ics.uci.edu/static/public/352/online+retail.zip"

if not os.path.exists("online_retail.zip"):
    !wget -q https://archive.ics.uci.edu/static/public/352/online+retail.zip -O online_retail.zip

with zipfile.ZipFile("online_retail.zip", "r") as z:
    excel_file = next(
        name for name in z.namelist()
        if name.lower().endswith(".xlsx")
    )
    z.extract(excel_file)

df = pd.read_excel(excel_file)

print("Dataset loaded successfully!")
print("Original dataset shape:", df.shape)
print("\nFirst 5 records:")
print(df.head())


# 2. Select columns and clean the dataset

df = df[
    ["InvoiceNo", "StockCode", "Description", "Quantity",
     "InvoiceDate", "UnitPrice", "CustomerID", "Country"]
].copy()

df.dropna(subset=["CustomerID", "StockCode", "Quantity", "UnitPrice"],
          inplace=True)

df = df[
    (df["Quantity"] > 0) &
    (df["UnitPrice"] > 0) &
    (~df["InvoiceNo"].astype(str).str.startswith("C"))
].copy()

df["CustomerID"] = df["CustomerID"].astype(int).astype(str)
df["StockCode"] = df["StockCode"].astype(str)

print("\nAfter cleaning:")
print("Dataset shape:", df.shape)


# 3. Calculate total sales

df["TotalAmount"] = df["Quantity"] * df["UnitPrice"]

print("\nTotal Sales:", round(df["TotalAmount"].sum(), 2))


# 4. Create customer-product interactions

interactions = (
    df.groupby(["CustomerID", "StockCode"], as_index=False)
      .agg(
          Quantity=("Quantity", "sum"),
          TotalAmount=("TotalAmount", "sum")
      )
)

print("\nCustomer-Product interactions:")
print(interactions.head())


# 5. Encode customer and product IDs

customer_encoder = LabelEncoder()
product_encoder = LabelEncoder()

interactions["CustomerIndex"] = customer_encoder.fit_transform(
    interactions["CustomerID"]
)
interactions["ProductIndex"] = product_encoder.fit_transform(
    interactions["StockCode"]
)

# Binary implicit feedback: 1 means purchased
interactions["Purchase"] = 1

num_customers = interactions["CustomerIndex"].nunique()
num_products = interactions["ProductIndex"].nunique()

print("\nFinal interaction dataset:")
print(interactions[
    ["CustomerIndex", "ProductIndex", "Purchase"]
].head())

print("\nTotal interaction records:", len(interactions))
print("Number of customers:", num_customers)
print("Number of products:", num_products)


# 6. Split data into training and testing sets

train_df, test_df = train_test_split(
    interactions,
    test_size=0.2,
    random_state=42
)

train_customers = train_df["CustomerIndex"].values
train_products = train_df["ProductIndex"].values
train_labels = train_df["Purchase"].values.astype("float32")

test_customers = test_df["CustomerIndex"].values
test_products = test_df["ProductIndex"].values
test_labels = test_df["Purchase"].values.astype("float32")


# 7. Build a two-tower embedding recommendation model

embedding_dim = 32

customer_input = Input(shape=(1,), name="customer_input")
product_input = Input(shape=(1,), name="product_input")

customer_embedding = Embedding(
    num_customers, embedding_dim, name="customer_embedding"
)(customer_input)

product_embedding = Embedding(
    num_products, embedding_dim, name="product_embedding"
)(product_input)

customer_vector = Flatten()(customer_embedding)
product_vector = Flatten()(product_embedding)

combined = Concatenate()([customer_vector, product_vector])

x = Dense(128, activation="relu")(combined)
x = Dropout(0.3)(x)
x = Dense(64, activation="relu")(x)
x = Dropout(0.2)(x)
x = Dense(32, activation="relu")(x)

output = Dense(1, activation="sigmoid")(x)

model = Model(
    inputs=[customer_input, product_input],
    outputs=output
)

model.compile(
    optimizer=Adam(learning_rate=0.001),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)

print("\nDeep Learning Recommendation Model:")
model.summary()


# 8. Train the model

history = model.fit(
    [train_customers, train_products],
    train_labels,
    validation_split=0.1,
    epochs=5,
    batch_size=512,
    verbose=1
)


# 9. Evaluate the model

loss, accuracy = model.evaluate(
    [test_customers, test_products],
    test_labels,
    verbose=0
)

print("\nModel Evaluation:")
print("Test Loss:", round(loss, 4))
print("Test Accuracy:", round(accuracy, 4))


# 10. Recommend top 10 products for a customer

def recommend_products(customer_id, top_n=10):
    customer_id = str(customer_id)

    if customer_id not in customer_encoder.classes_:
        print("Customer ID not found in the dataset.")
        return pd.DataFrame()

    customer_index = customer_encoder.transform([customer_id])[0]

    # Exclude products already purchased by this customer
    purchased = set(
        interactions.loc[
            interactions["CustomerID"] == customer_id,
            "ProductIndex"
        ]
    )

    candidates = np.array([
        p for p in range(num_products) if p not in purchased
    ])

    if len(candidates) == 0:
        print("No new products available to recommend.")
        return pd.DataFrame()

    customer_array = np.full(
        len(candidates), customer_index, dtype=np.int32
    )

    scores = model.predict(
        [customer_array, candidates],
        verbose=0
    ).flatten()

    top_indices = np.argsort(scores)[::-1][:top_n]
    recommended_indices = candidates[top_indices]

    stock_codes = product_encoder.inverse_transform(
        recommended_indices
    )

    descriptions = (
        df.drop_duplicates("StockCode")
          .set_index("StockCode")["Description"]
    )

    result = pd.DataFrame({
        "StockCode": stock_codes,
        "Description": [
            descriptions.get(code, "Description unavailable")
            for code in stock_codes
        ],
        "Score": scores[top_indices]
    })

    print(f"\nRecommended Products for Customer: {customer_id}")
    print(result.to_string(index=False))

    return result


# 11. Display recommendations

recommendation_table = recommend_products("12346", top_n=10)
